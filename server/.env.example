# Copy this file to .env and fill it in. .env must NEVER be committed; .env.example is safe to commit.

# development | production | test
NODE_ENV=development

PORT=5000

# Standard PostgreSQL URL (not prisma+postgres://)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/careerpilot"

# Signs every login cookie. Anyone who knows it can log in as anyone.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production requires at least 32 characters.
JWT_SECRET=

# Where the React app is served from. Several origins can be separated by commas.
# No path, and https:// in production.
CLIENT_URL="http://localhost:5173"

# lax (default) works when the app and API share a site. Use none ONLY when they are on
# different sites (for example two different hosting domains); it requires NODE_ENV=production.
COOKIE_SAME_SITE=lax

# How many reverse proxies sit in front of the server. 0 on your own machine,
# usually 1 on a hosting platform. Needed so rate limits see the real visitor.
TRUST_PROXY=0

# Where uploaded resume PDFs are stored. Leave empty to use server/uploads/resumes.
UPLOAD_DIR=

# true = this server also serves the built React app from client/dist, so pages and API share
# one address (this is how the hosted version runs). Leave false in development, where Vite
# serves the React app on its own port.
SERVE_CLIENT=false

# Folder holding the built React app. Leave empty to use client/dist.
CLIENT_DIST_DIR=

# Used only by `npm test`: a SEPARATE database the tests may wipe. Optional: if you leave it
# out, the tests use your DATABASE_URL with "_test" added to the database name
# (careerpilot -> careerpilot_test) and create it for you. The name must end in _test.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/careerpilot_test"