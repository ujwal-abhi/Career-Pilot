generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  name         String
  applications Application[]
  resumes      Resume[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum ApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model Application {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  company         String
  position        String
  status          ApplicationStatus  @default(SAVED)
  jobUrl          String?
  salary          String?
  location        String?
  jobDescription  String?
  applicationDate DateTime?
  notes           String?
  jobMatches      JobMatchAnalysis[]
  tailorings      ResumeTailoring[]
  interviewSets   InterviewSet[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model Resume {
  id            String             @id @default(uuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName      String
  storedName    String
  fileSize      Int
  extractedText String?
  isDefault     Boolean            @default(false)
  analyses      ResumeAnalysis[]
  jobMatches    JobMatchAnalysis[]
  tailorings    ResumeTailoring[]
  interviewSets InterviewSet[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model ResumeAnalysis {
  id              String   @id @default(uuid())
  resumeId        String
  resume          Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  overallScore    Int
  skillsScore     Int
  experienceScore Int
  projectsScore   Int
  keywordsScore   Int
  atsScore        Int
  strengths       String[]
  improvements    String[]
  createdAt       DateTime @default(now())
}

model JobMatchAnalysis {
  id                 String      @id @default(uuid())
  resumeId           String
  resume             Resume      @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  applicationId      String
  application        Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  matchScore         Int
  matchedSkills      String[]
  missingSkills      String[]
  relevantExperience String[]
  potentialGaps      String[]
  recommendations    String[]
  createdAt          DateTime    @default(now())
}

model ResumeTailoring {
  id            String      @id @default(uuid())
  resumeId      String
  resume        Resume      @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  summary       String
  skills        String[]
  bullets       String[]
  notes         String[]
  createdAt     DateTime    @default(now())
}

enum QuestionCategory {
  HR
  TECHNICAL
  BEHAVIORAL
  PROJECT
  ROLE_SPECIFIC
}

model InterviewSet {
  id            String              @id @default(uuid())
  resumeId      String
  resume        Resume              @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  notes         String[]
  questions     InterviewQuestion[]
  createdAt     DateTime            @default(now())
}

model InterviewQuestion {
  id              String           @id @default(uuid())
  interviewSetId  String
  interviewSet    InterviewSet     @relation(fields: [interviewSetId], references: [id], onDelete: Cascade)
  category        QuestionCategory
  question        String
  answerStructure String
  sortOrder       Int
  createdAt       DateTime         @default(now())
}