generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  name             String
  applications     Application[]
  resumes          Resume[]
  practiceAttempts PracticeAttempt[]
  reminders        Reminder[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

enum ApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model Application {
  id                   String                   @id @default(uuid())
  userId               String
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company              String
  position             String
  status               ApplicationStatus        @default(SAVED)
  jobUrl               String?
  salary               String?
  location             String?
  jobDescription       String?
  applicationDate      DateTime?
  notes                String?
  // Set by "Snooze" on a follow-up notification: hide the nudge until this time.
  followUpSnoozedUntil DateTime?
  jobMatches           JobMatchAnalysis[]
  tailorings           ResumeTailoring[]
  interviewSets        InterviewSet[]
  statusEvents         ApplicationStatusEvent[]
  interviews           Interview[]
  reminders            Reminder[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([userId])
}

// One row per status change. "Current status" only says where an application is
// NOW; this history says how far it ever got, which is what the funnel needs.
model ApplicationStatusEvent {
  id            String             @id @default(uuid())
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  createdAt     DateTime           @default(now())

  @@index([applicationId])
}

enum InterviewFormat {
  PHONE
  VIDEO
  ONSITE
}

// A scheduled interview. Named Interview because Step 10 deliberately left that name free
// (practice questions are InterviewSet / InterviewQuestion). scheduledAt is stored as a UTC
// instant; the browser converts to and from the person's local time.
model Interview {
  id            String          @id @default(uuid())
  applicationId String
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  format        InterviewFormat @default(VIDEO)
  scheduledAt   DateTime
  location      String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([applicationId, scheduledAt])
}

// A to-do with a due time. Optionally tied to an application; if that application is
// deleted the reminder goes with it, since it would no longer make sense.
model Reminder {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  dueAt         DateTime
  completedAt   DateTime?
  createdAt     DateTime     @default(now())

  @@index([userId, completedAt, dueAt])
}

model Resume {
  id            String             @id @default(uuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName      String
  storedName    String
  fileSize      Int
  extractedText String?
  isDefault     Boolean            @default(false)
  analyses      ResumeAnalysis[]
  jobMatches    JobMatchAnalysis[]
  tailorings    ResumeTailoring[]
  interviewSets InterviewSet[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model ResumeAnalysis {
  id              String   @id @default(uuid())
  resumeId        String
  resume          Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  overallScore    Int
  skillsScore     Int
  experienceScore Int
  projectsScore   Int
  keywordsScore   Int
  atsScore        Int
  strengths       String[]
  improvements    String[]
  createdAt       DateTime @default(now())
}

model JobMatchAnalysis {
  id                 String      @id @default(uuid())
  resumeId           String
  resume             Resume      @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  applicationId      String
  application        Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  matchScore         Int
  matchedSkills      String[]
  missingSkills      String[]
  relevantExperience String[]
  potentialGaps      String[]
  recommendations    String[]
  createdAt          DateTime    @default(now())
}

model ResumeTailoring {
  id            String      @id @default(uuid())
  resumeId      String
  resume        Resume      @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  summary       String
  skills        String[]
  bullets       String[]
  notes         String[]
  createdAt     DateTime    @default(now())
}

enum QuestionCategory {
  HR
  TECHNICAL
  BEHAVIORAL
  PROJECT
  ROLE_SPECIFIC
}

model InterviewSet {
  id            String              @id @default(uuid())
  resumeId      String
  resume        Resume              @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  notes         String[]
  questions     InterviewQuestion[]
  createdAt     DateTime            @default(now())
}

model InterviewQuestion {
  id              String            @id @default(uuid())
  interviewSetId  String
  interviewSet    InterviewSet      @relation(fields: [interviewSetId], references: [id], onDelete: Cascade)
  category        QuestionCategory
  question        String
  answerStructure String
  sortOrder       Int
  attempts        PracticeAttempt[]
  createdAt       DateTime          @default(now())
}

model PracticeAttempt {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId   String
  question     InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer       String
  wordCount    Int
  strengths    String[]
  improvements String[]
  notes        String[]
  failedChecks String[]
  passedCount  Int
  totalCount   Int
  createdAt    DateTime          @default(now())
}